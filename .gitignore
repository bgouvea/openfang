# Local OpenFang / agent workspace state
# Keep versionable definitions such as agent.toml, workflow JSON, TOOLS.md,
# SKILL.md/skill.toml, and example configs out of these broad runtime folders.
**/workspaces/*/memory/
**/workspaces/*/logs/
**/workspaces/*/sessions/
**/workspaces/*/data/
**/workspaces/*/output/
**/workspaces/*/AGENT.json
**/workspaces/*/BOOTSTRAP.md
**/workspaces/*/IDENTITY.md
**/workspaces/*/USER.md
**/workspaces/*/MEMORY.md
**/backups/

# Local runtime env/state files
secrets.env
openfang.log
openfang.pid

# Personal deploy scripts
scripts/deploy-remote.sh
